DATABASE_URL="postgresql://user:password@localhost:5432/productos"
NEXTAUTH_SECRET="generate-a-32-char-random-string-here"
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_SECRET="exactly-32-characters-long-here!"

# Google OAuth (optional — enables "Sign in with Google")
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAIN=""  # e.g., "redproduct.com" to restrict to your org domain

# Crawl4AI (optional — enables real web crawling for competitor intelligence)
# Run: docker run -d -p 11235:11235 --name crawl4ai --shm-size=1g unclecode/crawl4ai:latest
CRAWL4AI_URL="http://localhost:11235"

# LLM keys (optional fallbacks; keys are primarily stored encrypted in DB)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# File storage (use "local" for dev, "s3" for production)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
